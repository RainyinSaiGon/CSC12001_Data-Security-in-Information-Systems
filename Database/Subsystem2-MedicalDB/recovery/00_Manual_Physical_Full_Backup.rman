RUN {
  CONFIGURE CONTROLFILE AUTOBACKUP ON;
  ALLOCATE CHANNEL c1 DEVICE TYPE DISK FORMAT 'D:/oracle-backup/physical/full_%d_%T_%U.bkp';

  BACKUP AS COMPRESSED BACKUPSET DATABASE TAG 'MED_MANUAL_PHY_FULL_BASELINE';
  SQL 'ALTER SYSTEM ARCHIVE LOG CURRENT';
  BACKUP AS COMPRESSED BACKUPSET ARCHIVELOG ALL TAG 'MED_MANUAL_PHY_ARCH';
  BACKUP CURRENT CONTROLFILE TAG 'MED_MANUAL_PHY_CTL_FULL';
  BACKUP SPFILE TAG 'MED_MANUAL_PHY_SPFILE_FULL';

  RELEASE CHANNEL c1;
}
