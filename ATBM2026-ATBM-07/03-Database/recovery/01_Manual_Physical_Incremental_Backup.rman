RUN {
  CONFIGURE CONTROLFILE AUTOBACKUP ON;
  ALLOCATE CHANNEL c1 DEVICE TYPE DISK FORMAT 'D:/oracle-backup/physical/manual_inc_%d_%T_%U.bkp';

  BACKUP AS COMPRESSED BACKUPSET INCREMENTAL LEVEL 1 CUMULATIVE DATABASE TAG 'MED_MANUAL_PHY_INC_L1';
  BACKUP CURRENT CONTROLFILE TAG 'MED_MANUAL_PHY_CTL_L1';
  BACKUP SPFILE TAG 'MED_MANUAL_PHY_SPFILE_L1';

  RELEASE CHANNEL c1;
}
